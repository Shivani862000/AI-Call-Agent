{
  "name": "feedback-automation-system",
  "version": "1.0.0",
  "description": "Customer feedback automation system using Twilio, OpenAI, and Express",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "node --test --test-concurrency=1",
    "test:db": "REQUIRE_SUPABASE_TEST_DB=1 node --test --test-concurrency=1 tests/persistence/*.test.js",
    "db:push:test": "node scripts/push-test-migrations.js",
    "provision:webmaster": "node scripts/provision-webmaster.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.112.4",
    "cookie-session": "^2.1.1",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "openai": "^4.26.0",
    "pdfkit": "^0.13.0",
    "pg": "^8.23.0",
    "twilio": "^6.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "supabase": "^2.115.0",
    "supertest": "^7.2.2"
  }
}
