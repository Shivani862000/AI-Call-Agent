# Production. Lives at /opt/app/.env.prod on the droplet, never in git.
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://kcpathlab.vikitechsolutions.in

# Supabase (Mumbai) — use the Session pooler string, not db.<ref>.supabase.co,
# which is IPv6-only and will not resolve from most hosts.
SUPABASE_URL=postgresql://postgres.<prod-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=call-recordings

# Must differ from UAT: a shared secret means a UAT session token
# authenticates against production.
AUTH_SIGNING_SECRET=

GEMINI_API_KEY=
DEEPGRAM_API_KEY=

ICALLMATE_UKEY=
ICALLMATE_SERVICE_NO=
ICALLMATE_IVR_TEMPLATE_ID=
ICALLMATE_DID=8037259753
ICALLMATE_WEBHOOK_SECRET=
ICALLMATE_MEDIA_SHARED_SECRET=
ICALLMATE_MASTER_POST_WSURL=wss://kcpathlab.vikitechsolutions.in/icallmate/media

# Production owns the shared DID and answers inbound calls.
DISABLE_INBOUND_CALLS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
