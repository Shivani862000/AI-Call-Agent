ICALLMATE_MASTER_POST_CAMP_ID=54
ICALLMATE_MASTER_POST_LEAD_ID=1031
ICALLMATE_MASTER_POST_WSURL=wss://kcpathlab.vikitechsolution.in/icallmate/media
ICALLMATE_REQUIRE_MEDIA_TOKEN=false
SUBMITTED_CALL_GRACE_MS=120000
SUBMITTED_CALL_RETRY_MS=18000000
