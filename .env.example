# AI Provider Configuration
CALL_MODE=gemini-live
AI_PROVIDER=gemini-live
VOICE_PIPELINE=legacy


# Gemini + Deepgram voice configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
GEMINI_LIVE_THINKING_LEVEL=minimal
GEMINI_LIVE_SILENCE_DURATION_MS=600
GEMINI_LIVE_PREFIX_PADDING_MS=100
GEMINI_LIVE_DIRECT_AUDIO=true
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=180
GEMINI_LIVE_MAX_OUTPUT_TOKENS=340
FINAL_AUDIO_GRACE_MS=3000
DEEPGRAM_ENDPOINTING_MS=220
DEEPGRAM_FINAL_FLUSH_MS=180
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# OpenAI Realtime Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_TEXT_MODEL=gpt-4o-mini

# Deepgram Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key

# Queue / Storage / Database
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/ai_call_agent
OBJECT_STORAGE_BUCKET=feedback-call-recordings
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_DIR=./backups
DATABASE_BACKUP_RETENTION=7
DATABASE_BACKUP_INTERVAL_MS=86400000
SYSTEM_LOG_MAX_BYTES=10485760
SYSTEM_LOG_MAX_FILES=5

# Public webhook URL from ngrok (no trailing slash)
NGROK_URL=https://your-ngrok-url.ngrok-free.app
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app

# Test customer
CUSTOMER_PHONE=+14155550123
CUSTOMER_NAME=Customer Name


# Business context
CLIENT_NAME=Your Diagnostic Center

# iCallMate Integration
ICALLMATE_IBD_API_ENDPOINT=https://crm.icallmate.in
ICALLMATE_OBD_API_ENDPOINT=https://ecp1.icallmate.in
ICALLMATE_OUTBOUND_PROVIDER=masterpost
ICALLMATE_MASTER_POST_API_ENDPOINT=https://crm.icallmate.in/WebSVC111/setMasterPostAPI
ICALLMATE_MASTER_POST_CAMP_ID=54
ICALLMATE_MASTER_POST_LEAD_ID=1031
ICALLMATE_MASTER_POST_WSURL=wss://kcpathlab.vikitechsolutions.in/icallmate/media
ICALLMATE_REQUIRE_MEDIA_TOKEN=true
ICALLMATE_WEBHOOK_SECRET=replace_with_a_random_32_byte_secret
ICALLMATE_MEDIA_SHARED_SECRET=replace_with_a_different_random_32_byte_secret
ICALLMATE_REVERSE_MEDIA_CHUNK_BYTES=1600
ICALLMATE_PREFLIGHT_RETRY_MS=60000
SUBMITTED_CALL_GRACE_MS=360000
SUBMITTED_CALL_RETRY_MS=18000000
ICALLMATE_DID=8037259753
ICALLMATE_TEST_NUMBER=+918037259753
ICALLMATE_UKEY=
ICALLMATE_SERVICE_NO=
ICALLMATE_IVR_TEMPLATE_ID=
ICALLMATE_AGENT_ID=0
ICALLMATE_BOT_ID=0

# Server
PORT=3000
NODE_ENV=development

# Single-tenant authentication
# Generate a bcrypt hash: node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" -- 'your-password'
# Generate a signing secret: openssl rand -base64 48
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SIGNING_SECRET=

MAX_CALL_DURATION_SECONDS=80
