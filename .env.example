# AI Provider Configuration
CALL_MODE=gemini
AI_PROVIDER=gemini
VOICE_PIPELINE=legacy


# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Aoede
GEMINI_NATIVE_AUDIO_INPUT=false

# Live Transcription
LIVE_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=250
TEST_CALL_DEEPGRAM_MODEL=nova-3
TEST_CALL_DEEPGRAM_LANGUAGE=hi

# Gemini / LLM & TTS configuration
GEMINI_API_KEY=your_gemini_api_key
TEST_CALL_GEMINI_LLM_MODEL=gpt-4o-mini
TEST_CALL_GEMINI_TTS_MODEL=gpt-4o-mini-tts
TEST_CALL_GEMINI_TTS_VOICE=coral
GEMINI_REALTIME_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_REALTIME_VOICE=Aoede
GEMINI_REALTIME_REASONING_EFFORT=low
GEMINI_REALTIME_TURN_SILENCE_MS=450
GEMINI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
GEMINI_TRANSCRIPTION_LANGUAGE=hi
GEMINI_TRANSCRIPTION_DELAY=low
GEMINI_STT_SILENCE_COMMIT_MS=350
GEMINI_STT_MAX_SEGMENT_MS=2500
GEMINI_BATCH_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Queue / Storage / Database
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/ai_call_agent
OBJECT_STORAGE_BUCKET=feedback-call-recordings

# Public webhook URL from ngrok (no trailing slash)
NGROK_URL=https://your-ngrok-url.ngrok-free.app
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app

# Test customer
CUSTOMER_PHONE=+14155550123
CUSTOMER_NAME=Customer Name


# Business context
CLIENT_NAME=Your Diagnostic Center

# iCallMate Integration
ICALLMATE_IBD_API_ENDPOINT=https://crm.icallmate.in
ICALLMATE_OBD_API_ENDPOINT=https://ecp1.icallmate.in
ICALLMATE_OUTBOUND_PROVIDER=campaign
ICALLMATE_MASTER_POST_API_ENDPOINT=https://crm.icallmate.in/WebSVC111/setMasterPostAPI
ICALLMATE_MASTER_POST_CAMP_ID=
ICALLMATE_MASTER_POST_LEAD_ID=
ICALLMATE_MASTER_POST_WSURL=wss://your-public-domain.example/icallmate/media
ICALLMATE_DID=8037259753
ICALLMATE_TEST_NUMBER=+918037259753
ICALLMATE_UKEY=
ICALLMATE_SERVICE_NO=
ICALLMATE_IVR_TEMPLATE_ID=
ICALLMATE_AGENT_ID=0
ICALLMATE_BOT_ID=0

# Server
PORT=3000
NODE_ENV=development
