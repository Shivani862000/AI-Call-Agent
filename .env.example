# Runtime
NODE_ENV=production
PORT=3000
COOKIE_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Supabase/Postgres (runtime uses the direct database connection, not the Data API)
SUPABASE_DB_URL=postgresql://runtime-user:replace-me@db.example.supabase.co:5432/postgres
SUPABASE_DB_CA_CERT=-----BEGIN CERTIFICATE-----\nreplace-with-provider-ca\n-----END CERTIFICATE-----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Provisioning only. Do not place this in the normal application runtime environment.
SUPABASE_SECRET_KEY=replace-with-secret-key-only-while-running-provisioning

# Public HTTPS base URL used by Twilio callbacks
NGROK_URL=https://calls.example.com
WEBHOOK_URL=https://calls.example.com

# Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+14155550100
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI provider
CALL_MODE=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
OPENAI_API_KEY=replace-with-openai-api-key-if-openai-is-selected
OPENAI_REALTIME_MODEL=gpt-realtime

# Business defaults used only when an operator does not supply a value
CUSTOMER_PHONE=+14155550123
CUSTOMER_NAME=Customer Name
CLIENT_NAME=Your Diagnostic Center
