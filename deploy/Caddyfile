# Two hostnames, two containers, one droplet.
#
# Caddy obtains and renews TLS from Let's Encrypt automatically, and
# reverse_proxy passes WebSocket upgrades through on its own — the media
# bridge holds a socket open for a whole call and needs no special handling.

{
	email {$ACME_EMAIL}
}

kcpathlab.vikitechsolutions.in {
	reverse_proxy prod:3000
	encode gzip
	log {
		output file /var/log/caddy/prod.log
		format json
	}
}

uat-kcpathlab.vikitechsolutions.in {
	reverse_proxy uat:3000
	encode gzip
	log {
		output file /var/log/caddy/uat.log
		format json
	}
}

# Old bookmarks point at the droplet's IP. Caddy redirects every plain HTTP
# request to HTTPS, and no certificate can exist for a bare IP, so those
# bookmarks died at a TLS error rather than a login page. The explicit http://
# scheme stops Caddy trying to serve this over TLS itself.
#
# It goes to UAT because that is what port 80 on this IP used to serve.
http://64.227.128.128 {
	redir https://uat-kcpathlab.vikitechsolutions.in{uri} permanent
}
