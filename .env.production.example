# ── Supabase Postgres ─────────────────────────────────────────────────────────
# SUPABASE_URL_DEV is used for local / dev / UAT (anything NODE_ENV != production)
# SUPABASE_URL     is used for production
# DATABASE_URL overrides both; one-off scripts use it to target one database.
# Use the Session pooler string if your host has no IPv6 - the direct
# db.<ref>.supabase.co host resolves to AAAA records only.
SUPABASE_URL_DEV=postgresql://postgres.<dev-ref>:<password>@db.<dev-ref>.supabase.co:5432/postgres
SUPABASE_URL=postgresql://postgres.<prod-ref>:<password>@db.<prod-ref>.supabase.co:5432/postgres

# Public application URL
SERVER_NAME=kcpathlab.vikitechsolutions.in
APP_BASE_URL=https://kcpathlab.vikitechsolutions.in
NGROK_URL=
WEBHOOK_URL=https://kcpathlab.vikitechsolutions.in

# Server
PORT=3000
NODE_ENV=production
TZ=Asia/Kolkata

# Authentication
# Login accounts live in the users table, not here. Bootstrap the first admin:
#   node scripts/manage-users.js create --username you@example.com --role ADMIN
# After that, manage users at /users.html. (all values are required in production)
# Generate a signing secret: openssl rand -base64 48
AUTH_SIGNING_SECRET=

# Persistent app database path inside the container
SYSTEM_LOG_MAX_BYTES=10485760
SYSTEM_LOG_MAX_FILES=5

# Business context
CLIENT_NAME=Your Business Name
CUSTOMER_PHONE=+911234567890
CUSTOMER_NAME=Customer Name

# AI runtime
CALL_MODE=gemini-live
AI_PROVIDER=gemini-live
VOICE_PIPELINE=legacy
DISABLE_SCHEDULER=false
DISABLE_OWNER_DIGEST=false

# Gemini + Deepgram voice
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
GEMINI_LIVE_THINKING_LEVEL=minimal
GEMINI_LIVE_SILENCE_DURATION_MS=600
GEMINI_LIVE_PREFIX_PADDING_MS=100
GEMINI_LIVE_DIRECT_AUDIO=true
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=180
GEMINI_LIVE_MAX_OUTPUT_TOKENS=340
FINAL_AUDIO_GRACE_MS=3000
DEEPGRAM_ENDPOINTING_MS=220
DEEPGRAM_FINAL_FLUSH_MS=180
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_TEXT_MODEL=gpt-4o-mini

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Optional notifications and reports
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+911234567890
GOOGLE_REVIEW_LINK=https://g.page/r/example/review

# Optional cost and integration settings
ESTIMATED_AI_CALL_COST_INR=8
ESTIMATED_STAFF_CALL_COST_INR=25
CRM_WEBHOOK_URL=https://example.com/webhooks/crm

# iCallMate Integration
ICALLMATE_IBD_API_ENDPOINT=https://crm.icallmate.in
ICALLMATE_OBD_API_ENDPOINT=https://ecp1.icallmate.in
ICALLMATE_OUTBOUND_PROVIDER=masterpost
ICALLMATE_MASTER_POST_API_ENDPOINT=https://crm.icallmate.in/WebSVC111/setMasterPostAPI
ICALLMATE_MASTER_POST_CAMP_ID=54
ICALLMATE_MASTER_POST_LEAD_ID=1031
ICALLMATE_MASTER_POST_WSURL=wss://kcpathlab.vikitechsolutions.in/icallmate/media
ICALLMATE_REQUIRE_MEDIA_TOKEN=true
ICALLMATE_WEBHOOK_SECRET=replace_with_a_random_32_byte_secret
ICALLMATE_MEDIA_SHARED_SECRET=replace_with_a_different_random_32_byte_secret
ICALLMATE_REVERSE_MEDIA_CHUNK_BYTES=1600
ICALLMATE_PREFLIGHT_RETRY_MS=60000
ICALLMATE_DID=8037259753
ICALLMATE_TEST_NUMBER=+918037259753
ICALLMATE_UKEY=
ICALLMATE_SERVICE_NO=
ICALLMATE_IVR_TEMPLATE_ID=
ICALLMATE_AGENT_ID=0
ICALLMATE_BOT_ID=0
