# Public application URL
SERVER_NAME=kcpathlab.vikitechsolutions.in
APP_BASE_URL=https://kcpathlab.vikitechsolutions.in
NGROK_URL=
WEBHOOK_URL=https://kcpathlab.vikitechsolutions.in

# Server
PORT=3000
NODE_ENV=production
TZ=Asia/Kolkata

# Persistent app database path inside the container
DATABASE_URL=/app/data/feedback.db

# Business context
CLIENT_NAME=Your Business Name
CUSTOMER_PHONE=+911234567890
CUSTOMER_NAME=Customer Name

# AI runtime
CALL_MODE=gemini
VOICE_PIPELINE=legacy
DISABLE_SCHEDULER=false
DISABLE_OWNER_DIGEST=false

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Optional notifications and reports
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+911234567890
SENDGRID_API_KEY=your_sendgrid_api_key
GOOGLE_REVIEW_LINK=https://g.page/r/example/review

# Optional cost and integration settings
ESTIMATED_AI_CALL_COST_INR=8
ESTIMATED_STAFF_CALL_COST_INR=25
CRM_WEBHOOK_URL=https://example.com/webhooks/crm

# iCallMate Integration
ICALLMATE_IBD_API_ENDPOINT=https://crm.icallmate.in
ICALLMATE_OBD_API_ENDPOINT=https://ecp1.icallmate.in
ICALLMATE_DID=8037259753
ICALLMATE_TEST_NUMBER=+918037259753
ICALLMATE_UKEY=
ICALLMATE_SERVICE_NO=
ICALLMATE_IVR_TEMPLATE_ID=
ICALLMATE_AGENT_ID=0
ICALLMATE_BOT_ID=0
