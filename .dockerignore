# Deny by default: only runtime assets belong in the production context.
**
!package.json
!package-lock.json
!index.js
!db.js
!src/
!src/**
!services/
!services/**
!routes/
!routes/**
!public/
!public/**
!utils/
!utils/**
!prompts/
!prompts/**
!supabase/
!supabase/migrations/
!supabase/migrations/*.sql
!scripts/
!scripts/migrate.js
!scripts/manage-users.js

# SQL belongs only in the migration directory.
**/*.sql
!supabase/migrations/*.sql

# Apply after every allowlist exception, including migration SQL.
**/.env
**/.env.*
**/*credential*
**/*service-account*
**/*service_account*
**/*.iam.gserviceaccount.com.json
**/*gmail*key*
**/*client_secret*
**/*client-secret*
**/*oauth*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
**/*.db*
**/*.sqlite*
**/*.bak
**/*.backup*
**/*.archive*
**/*.zip
**/*.tar
**/*.tgz
**/*.gz
